{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Smartboxx": {
    "DefaultTenant": "acme-demo",
    "IsolationModel": "shared-store-tenant-key",
    "Clients": {
      "acme-demo": {
        "Id": "acme-demo", "ClientName": "Acme Demo", "ProductName": "Acme Intelligence Hub",
        "Terminology": { "document": "case" },
        "Features": { "documents": true, "contact-centre": false, "software-delivery": false, "testing": true, "api-intelligence": false, "value": true },
        "AiRouting": { "document-classification": "balanced-chat" },
        "Identity": { "Mode": "Local" }, "Storage": { "Provider": "FileSystem" }, "VectorStore": { "Provider": "PostgreSql" }, "RetentionDays": 365,
        "Branding": { "Logo": "/assets/acme-logo.svg", "Favicon": "/assets/acme-favicon.svg", "Theme": { "primary": "#14532d", "accent": "#f59e0b", "surface": "#f7fee7" } },
        "Roles": { "viewer": [ "documents.view", "value.view" ], "operator": [ "documents.view", "documents.upload", "documents.review", "testing.execute" ], "admin": [ "documents.admin", "platform.admin" ] },
        "Navigation": [
          { "Label": "Documents", "Route": "/documents", "Feature": "documents", "Permission": "documents.view" },
          { "Label": "Testing", "Route": "/testing", "Feature": "testing", "Permission": "testing.execute" },
          { "Label": "Value", "Route": "/value", "Feature": "value", "Permission": "value.view" }
        ]
      },
      "northwind-demo": {
        "Id": "northwind-demo", "ClientName": "Northwind Synthetic", "ProductName": "Northwind Operations",
        "Features": { "documents": false, "contact-centre": true, "value": false }, "AiRouting": {},
        "Identity": { "Mode": "Local" }, "Storage": { "Provider": "FileSystem" }, "VectorStore": { "Provider": "PostgreSql" }, "RetentionDays": 90,
        "Branding": { "Logo": "/assets/northwind-logo.svg", "Favicon": "/assets/northwind-favicon.svg", "Theme": { "primary": "#1d4ed8", "accent": "#06b6d4", "surface": "#eff6ff" } },
        "Roles": { "viewer": [ "contactCentre.view" ], "admin": [ "platform.admin" ] },
        "Navigation": [ { "Label": "Contact Centre", "Route": "/contact-centre", "Feature": "contact-centre", "Permission": "contactCentre.view" } ]
      }
    }
  }
}
